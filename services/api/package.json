{
  "name": "@autokeep/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/handler.mjs && esbuild src/worker.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/worker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@autokeep/domain": "0.1.0",
    "@aws-sdk/client-dynamodb": "^3.883.0",
    "@aws-sdk/client-sesv2": "^3.883.0",
    "@aws-sdk/client-sns": "^3.883.0",
    "@aws-sdk/lib-dynamodb": "^3.883.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
